---
import Layout from '@layouts/Layouts.astro';
import ProjectCard from '@components/ProjectCard.astro';
---

<Layout title="Projects">
  <section class="py-14">
    <div class="mx-auto w-[min(100%-40px,1120px)]">
      <h1 class="text-4xl font-extrabold tracking-tight mb-4">All Projects</h1>
      <p class="max-w-2xl text-lg text-white/70 mb-10">
        A collection of in-depth analyses spanning multiple domains, datasets, and methodologies.
      </p>

      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3 justify-center">
        <ProjectCard
          imageSrc="/projects/basic-basket/header.jpg"
          imageAlt="Basic Basket"
          title="Basic Basket"
          description="Comprehensive analysis of the basic consumer basket. Includes studies on vegetable price volatility and acquisition segmented by social class."
          tags={["2 Analyses"]}
          href="/projects/basic-basket"
          buttonText="View project hub"
        />

        <ProjectCard
          imageSrc=""
          imageAlt="Labor Market"
          title="Labor Market"
          description="Coming soon: Analysis of the labor market, wages, and hiring trends."
          tags={["Coming soon"]}
          href="#"
          buttonText="Coming soon"
        />
      </div>
    </div>
  </section>
</Layout>
