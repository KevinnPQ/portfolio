---
import Layout from '@layouts/Layouts.astro';
---

<Layout title="Projects">
  <section class="py-14">
    <div class="mx-auto w-[min(100%-40px,1120px)]">
      <h1 class="text-4xl font-extrabold tracking-tight mb-4">All Projects</h1>
      <p class="max-w-2xl text-lg text-white/70 mb-10">
        A collection of in-depth analyses spanning multiple domains, datasets, and methodologies.
      </p>

      <div class="grid gap-6 md:grid-cols-2">
        <article class="flex min-h-[320px] flex-col rounded-2xl border border-white/10 bg-white/5 transition-transform hover:-translate-y-1">
          <div class="h-32 border-b border-white/10 bg-gradient-to-r from-indigo-500/30 to-cyan-400/20"></div>
          <div class="flex flex-1 flex-col gap-4 p-5">
            <h2 class="text-2xl font-extrabold">Basic Basket</h2>
            <p class="text-white/70">
              Comprehensive analysis of the basic consumer basket. Includes studies on vegetable price volatility
              and acquisition segmented by social class.
            </p>
            <div class="mt-auto flex flex-wrap gap-2">
              <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-xs font-bold text-white/80">
                2 Analyses
              </span>
            </div>
            <a
              href="/projects/basic-basket"
              class="mt-4 block w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-center text-sm font-bold hover:bg-white/10"
            >
              View project hub
            </a>
          </div>
        </article>

        <article class="flex min-h-[320px] flex-col rounded-2xl border border-white/10 bg-white/5 transition-transform hover:-translate-y-1 opacity-70">
          <div class="h-32 border-b border-white/10 bg-gradient-to-r from-emerald-500/30 to-teal-400/20"></div>
          <div class="flex flex-1 flex-col gap-4 p-5">
            <h2 class="text-2xl font-extrabold">Labor Market</h2>
            <p class="text-white/70">
              Coming soon: Analysis of the labor market, wages, and hiring trends.
            </p>
            <div class="mt-auto flex flex-wrap gap-2">
              <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-1 text-xs font-bold text-white/80">
                Coming soon
              </span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>
</Layout>
