---
import Header from '@components/Header.tsx';
import Footer from '@components/Footer.astro';
import '../assets/global.css';

interface Props {
  title?: string;
  hideHeader?: boolean;
}

const { title = "Kevinn Perez Quesada - Portfolio", hideHeader = false } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body id="top" class="bg-[#0a0f1e] text-white antialiased min-h-screen flex flex-col">
    <a href="#main" class="absolute left-[-999px] top-3 rounded-xl border border-white/10 bg-white/10 px-4 py-2 focus:left-4 z-[60]">
      Skip to content
    </a>
    
    {!hideHeader && <Header client:load />}

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
